# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
# Secret (service-role) key — server-only, used by the daily cron
SUPABASE_SECRET_KEY=

# Single-user allowlist — the only Google email allowed to sign in
ALLOWED_EMAIL=you@example.com

# Gemini — free key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Web push — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Vercel sends this as a Bearer token to /api/cron/daily — generate with: openssl rand -hex 32
CRON_SECRET=
